meta {
  name: SendPasswordReset
  type: http
  seq: 6
}

post {
  url: {{url}}admin/users/2/password-reset
  body: none
  auth: inherit
}

docs {
  Admin only. Mails a 1 h reset link; while the account has no password it mails the 72 h welcome link again instead. Logs password_reset_sent or welcome_sent. 204 on success, 409 ai_user or deactivated, 502 mail_failed when the mail server refuses.
}

settings {
  encodeUrl: true
}
