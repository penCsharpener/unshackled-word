meta {
  name: GetHistory
  type: http
  seq: 9
}

get {
  url: {{url}}revision/verse/bookId/:bookId/chapterId/:chapter/verseId/:verse/history?level=200
  body: none
  auth: inherit
}

params:path {
  verse: 16
  chapter: 3
  bookId: 43
}

docs {
  Needs a login cookie with role admin or maintainer. 200 {level, versions:[{revisionVerseId, version, text, note, isActive, createdAt, createdBy, endedAt}]} newest first, ended versions included; 400 level 100; 404 unknown verse.
}

settings {
  encodeUrl: true
}
