meta {
  name: StartSeedJobUpdate
  type: http
  seq: 4
}

post {
  url: {{url}}maintainer/seed/jobs
  body: json
  auth: inherit
}

body:json {
  {
    "operation": "update",
    "kind": "revision"
  }
}

docs {
  Rolling update with the newer seed: variants/verses nobody changed since the last import are replaced, locally changed ones are kept and listed (kept), new ones added, withdrawn ones ended. Skipped without a SeedImports baseline or when the seed is already the imported version. Morphology is never updated.
}

settings {
  encodeUrl: true
}
