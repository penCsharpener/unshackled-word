# Monitoring layer (compose.monitoring.yml). Copy the variables you need into .env. Placeholders only, never commit real secrets.

# Telemetry (OpenTelemetry export from WebApi and McpServer)
#TELEMETRY_ENABLED=true
# Dev (API on host networking): http://localhost:4317
#TELEMETRY_OTLP_ENDPOINT=http://unshackledword.monitoring:4317
#TELEMETRY_TRACE_SAMPLE_RATIO=1.0

# Grafana
#GRAFANA_ADMIN_PASSWORD=change-me
#GRAFANA_ROOT_URL=http://localhost:3000
#GRAFANA_SMTP_STARTTLS_POLICY=NoStartTLS
#MONITORING_ALERT_EMAIL=alerts@unshackled-word.local
#MONITORING_GRAFANA_DB_PASSWORD=change-me

# Postgres monitoring roles (uw_monitor for postgres-exporter, uw_grafana for Grafana)
#MONITORING_EXPORTER_DB_PASSWORD=change-me

# Umami web analytics
#UMAMI_DB_PASSWORD=change-me
#UMAMI_APP_SECRET=change-me-to-a-long-random-string
#UMAMI_PROXY_TARGET=http://host.docker.internal:3002

# Frontend build-time values (Vite)
#VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
#VITE_OPERATOR_NAME=Your name or organisation
#VITE_OPERATOR_CONTACT=contact@example.org
