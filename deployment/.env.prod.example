# Production environment for `docker compose --env-file deployment/.env -f compose.yml -f deployment/compose.prod.yml`.
# Copy to `deployment/.env` on the production host, fill in every <___ ... ___> (search for "<___"), then `chmod 600`.
# Never commit the filled-in copy. Details: docs/deployment.md

# --- Database ---------------------------------------------------------------
POSTGRES_DB=unshackledword
POSTGRES_USER=unshackledword
POSTGRES_PASSWORD=<___ long random password, e.g. `openssl rand -base64 36` ___>
# Host is the compose service name; user/db/password must match the three values above.
POSTGRES_CONNECTIONSTRING="Host=unshackledword.tooling.database;Port=5432;Database=unshackledword;Username=unshackledword;Password=<___ same password ___>;"

# --- App --------------------------------------------------------------------
ENVIRONMENT=Production
# Exact public https origin, no trailing path. Drives email links, CORS and the passkey origin/RP id.
# Changing the host later invalidates every registered passkey.
FRONTEND_BASE_URL=https://<___ your-domain ___>
REQUIRE_SECURE_COOKIES=true
# Open while you register the first account (it becomes admin), then Restricted and restart the API.
REGISTRATION_MODE=Open
MAPPING_EDITING_ENABLED=false

# Optional CIDR of the proxy network; rate limiting uses the client IP taken from X-Forwarded-For.
RATE_LIMITING_ENABLED=true
REVERSE_PROXY_NETWORK=

# --- Email (real SMTP account; the bundled Mailpit never delivers) ----------
EMAIL_SMTP_HOST=<___ smtp.example.org ___>
EMAIL_SMTP_PORT=587
# 587 -> StartTls, 465 -> SslOnConnect; None | StartTls | SslOnConnect | Auto
EMAIL_SECURITY=StartTls
EMAIL_USERNAME=<___ smtp user ___>
EMAIL_PASSWORD=<___ smtp password ___>
EMAIL_FROM_ADDRESS=noreply@<___ your-domain ___>

# --- AI agent runs (optional, roadmap 0016) ---------------------------------
# Key of the "ollama" profile (Ollama Cloud). Empty = profile unusable.
UNSHACKLEDWORD_AgentMapping__Profiles__ollama__ApiKey=

# --- MCP server (optional, profile `mcp`) -----------------------------------
MCP_LOG_LEVEL=Information
MCP_MAX_PROPOSALS_PER_TOKEN_PER_DAY=300

# --- Reverse proxy (Nginx Proxy Manager on another host, see deployment/compose.prod.yml) ---
# Address:port on this Docker host that NPM forwards to (bind to the LAN IP, never 0.0.0.0 if the host is exposed).
# In NPM: Proxy Host for <___ your-domain ___> -> http://192.168.30.22:8081, SSL certificate + Force SSL + HTTP/2 on.
WEB_BIND=<___ lan-ip:port that NPM forwards to, e.g. 192.168.30.22:8081 ___>
