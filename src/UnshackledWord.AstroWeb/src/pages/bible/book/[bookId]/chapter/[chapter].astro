---
import BookChapterSelector from "../../../../../components/navigation/BookChapterSelector.astro";
import Layout from "../../../../../layouts/Layout.astro";
import bibleData from "../../../../../data/bibleData.json";
import type { WordResponse } from "../../../../../types";
import ElbBibleWord from "../../../../../components/bible/ElbBibleWord.astro";
const allBooks = [...bibleData.OT, ...bibleData.NT];

export async function getStaticPaths() {
  const allBooks = [...bibleData.OT, ...bibleData.NT];
  // Create a route for every chapter in every book
  return allBooks.flatMap((book) => {
    return Array.from({ length: book.chapters }, (_, i) => ({
      params: {
        bookId: book.id.toString(),
        chapter: (i + 1).toString(),
      },
      props: { bookName: book.name }, // Optional: pass data to the page
    }));
  });
}

const { bookId, chapter } = Astro.params;
const currentBook = allBooks.find(b => b.id === Number(bookId));

// Use the parameters in your API call
const response = await fetch(
  `${import.meta.env.PUBLIC_API_DOMAIN}/elberfelder/chapterWords/bookId/${bookId}/chapterId/${chapter}`,
);
const data = await response.json();

const wordEntries = data.words as WordResponse[];
---

<Layout title={`${currentBook?.name} ${chapter} - Entfesseltes Word`}>
  <BookChapterSelector />
  <div class="p-5">
    <h1 class="text-4xl md:text-5xl font-medium text-slate-400 tracking-tight mt-3 text-right">
      {currentBook?.name} {chapter}
    </h1>

    <div class="bible-chapter">
      {
        wordEntries.map((info) => {
          return (
            <ElbBibleWord info={info}/>
          );
        })
      }
    </div>
  </div>
</Layout>

<script>
  const container = document.querySelector('.bible-chapter');

  container?.addEventListener('mouseover', (e) => {
    if (e.target instanceof HTMLElement) {
      const target = e.target.closest('[data-strongs]');
      if (!target) return;

      const strongsId = target.getAttribute('data-strongs');
      const matches = container.querySelectorAll(`[data-strongs="${strongsId}"]`);
      
      matches.forEach(el => el.style.backgroundColor = 'lightblue');
    }
  });

  container?.addEventListener('mouseout', (e) => {
    if (e.target instanceof HTMLElement) {
      const target = e.target.closest('[data-strongs]');
      if (!target) return;

      const strongsId = target.getAttribute('data-strongs');
      const matches = container.querySelectorAll(`[data-strongs="${strongsId}"]`);
      
      matches.forEach(el => el.style.backgroundColor = '');
    }
  });
</script>