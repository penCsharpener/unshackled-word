---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Forgot Password">
  <main class="max-w-md mx-auto mt-12 p-8 bg-white rounded-2xl shadow-sm">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Reset Password</h1>
    <p class="text-sm text-gray-600 mb-6">Enter your email and we'll send you a reset code.</p>
    
    <form id="forgot-form" class="space-y-4">
      <input type="email" name="email" required placeholder="you@example.com" 
             class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
      <button type="submit" class="w-full py-3 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700">
        Send Reset Code
      </button>
      <div id="status-msg" class="hidden p-3 text-sm rounded-lg"></div>
    </form>
  </main>
</Layout>

<script>
  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const statusMsg = document.getElementById('status-msg') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(form).get('email');

    try {
      const response = await fetch(`${import.meta.env.PUBLIC_API_DOMAIN}/api/auth/forgotPassword`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });

      // Identity API returns 200 even if email doesn't exist for security
      statusMsg.className = "p-3 text-sm rounded-lg bg-green-50 text-green-700 block";
      statusMsg.textContent = "If an account exists, a reset code has been sent.";
    } catch {
      statusMsg.className = "p-3 text-sm rounded-lg bg-red-50 text-red-700 block";
      statusMsg.textContent = "Server error. Please try again later.";
    }
  });
</script>
