---
import bibleData from "../../data/bibleData.json";
interface Props {
  baseRoute: string;
}

const { baseRoute } = Astro.props;
---

<div class="max-w-full mx-auto">
  <!-- Split Button: Rounded only on corners to touch the menu below -->
  <div class="flex w-full overflow-hidden border text-gray-600 text-lg border-gray-300 shadow-md">
    <button id="ot-btn" class="flex-1 py-4 bg-gray-100 hover:bg-gray-200 font-bold border-r border-gray-300 transition-colors uppercase tracking-wider">
      Old Testament
    </button>
    <button id="nt-btn" class="flex-1 py-4 bg-gray-100 hover:bg-gray-200 font-bold transition-colors uppercase tracking-wider">
      New Testament
    </button>
  </div>

  <!-- Unrolling Container -->
  <div id="menu-container" class="grid transition-all duration-500 ease-in-out overflow-hidden shadow-xl" style="grid-template-rows: 0fr;">
    <div class="min-h-0 overflow-y-auto max-h-[calc(100dvh-154px)]"> <!-- Required for grid-row transition to work -->
      
      <!-- OT Menu -->
      <div id="ot-menu" class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 xl:grid-cols-7 border-x border-b border-gray-300">
        {bibleData.OT.map((book) => (
          <div class="border-[0.5px] border-gray-200 bg-white p-0">
            <div class="bg-gray-100 px-3 py-1 font-bold text-sm border-b border-gray-200">{book.name}</div>
            <div class="flex flex-wrap">
              {Array.from({ length: book.chapters }, (_, i) => i + 1).map((ch) => (
                <a href={`/${baseRoute}/book/${book.id}/chapter/${ch + book.startChapter}`} class="flex-grow basis-10 h-10 flex items-center justify-center border-[0.1px] border-gray-100 hover:bg-blue-600 hover:text-white text-xs transition-colors">
                  {ch + book.startChapter}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- NT Menu -->
      <div id="nt-menu" class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 xl:grid-cols-7 border-x border-b border-gray-300">
        {bibleData.NT.map((book) => (
          <div class="border-[0.5px] border-gray-200 bg-white p-0">
            <div class="bg-gray-100 px-3 py-1 font-bold text-sm border-b border-gray-200">{book.name}</div>
            <div class="flex flex-wrap">
              {Array.from({ length: book.chapters }, (_, i) => i + 1).map((ch) => (
                <a href={`/${baseRoute}/book/${book.id}/chapter/${ch}`} class="flex-grow basis-10 h-10 flex items-center justify-center border-[0.1px] border-gray-100 hover:bg-green-600 hover:text-white text-xs transition-colors">
                  {ch}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</div>

<script>
  const otBtn = document.getElementById('ot-btn');
  const ntBtn = document.getElementById('nt-btn');
  const otMenu = document.getElementById('ot-menu');
  const ntMenu = document.getElementById('nt-menu');
  const container = document.getElementById('menu-container');

  function toggle(targetMenu, otherMenu, activeBtn, otherBtn) {
    const isOpening = targetMenu.classList.contains('hidden') || container.style.gridTemplateRows === '0fr';
    
    if (isOpening) {
      otherMenu.classList.add('hidden');
      targetMenu.classList.remove('hidden');
      container.style.gridTemplateRows = '1fr';
      activeBtn.classList.add('bg-gray-100');
      otherBtn.classList.remove('bg-gray-100');
    } else {
      container.style.gridTemplateRows = '0fr';
      activeBtn.classList.remove('bg-gray-100');
    }
  }

  otBtn.addEventListener('click', () => toggle(otMenu, ntMenu, otBtn, ntBtn));
  ntBtn.addEventListener('click', () => toggle(ntMenu, otMenu, ntBtn, otBtn));
</script>
