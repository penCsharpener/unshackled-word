---
// src/components/VersePicker.astro
import maxVerseData from "../../data/max-verse-data.json";

interface Props {
  bookId: number; // Now a number
  chapter: number;
  width?: string;
  height?: string;
}

const { bookId, chapter, width = "100%", height = "auto" } = Astro.props;

// 1. Find the book by numeric ID
const book = maxVerseData.find((b) => b.id === bookId);

// 2. Find the chapter
const chapterData = book?.chapters.find((c) => c.chapter === chapter);

// 3. Extract max verse
const maxVerses = chapterData?.maxVerse || 0;
const verses = Array.from({ length: maxVerses }, (_, i) => i + 1);
---

<div 
  class="verse-picker-root grid grid-cols-[repeat(auto-fill,minmax(40px,1fr))] gap-2 p-4 border border-slate-200 rounded-lg overflow-y-auto bg-white shadow-inner"
  style={{ width, height }}
>
  {verses.length > 0 ? (
    verses.map((num) => (
      <button
        type="button"
        data-verse={num}
        class="verse-box aspect-square flex items-center justify-center border border-slate-200 rounded-md text-sm font-semibold text-slate-700 transition-all hover:bg-indigo-600 hover:text-white hover:border-indigo-600 hover:shadow-sm active:scale-90 focus:outline-none focus:ring-2 focus:ring-indigo-500"
      >
        {num}
      </button>
    ))
  ) : (
    <div class="col-span-full flex flex-col items-center justify-center py-8 text-slate-400">
      <span class="text-sm italic">Data not found for Book {bookId}, Chapter {chapter}</span>
    </div>
  )}
</div>

<script>
  function initVersePicker() {
    const pickers = document.querySelectorAll('.verse-picker-root');

    pickers.forEach(picker => {
      picker.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.verse-box');
        if (btn) {
          const verseNum = btn.getAttribute('data-verse');
          
          // Emit custom event
          picker.dispatchEvent(new CustomEvent('verseSelected', {
            detail: { verse: parseInt(verseNum || '0') },
            bubbles: true
          }));
        }
      });
    });
  }

  // Handle standard load and Astro view transitions
  initVersePicker();
  document.addEventListener('astro:after-swap', initVersePicker);
</script>
