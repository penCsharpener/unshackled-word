---
import type { WordResponse } from "../../types";

const info = Astro.props.info as WordResponse;
const isFirstInVerse = info.positionInVerse === 1;
---

{/* Render a verse number if this is the start of a new verse */}
{isFirstInVerse && <br>}
{isFirstInVerse && <sup class="verse-num">{info.verse}{` `}</sup>}
<span
class:list={[
  "bible-word",
  { "no-strongs": !info.strongs }
]}
data-order={info.positionInVerse}
data-plain={info.plainWord}
data-lemma={info.lemma}
data-strongs={info.strongs}
data-original={info.original}
data-id={info.id}
>
{`${info.wordInContext}`}
</span>
{` `}


<style>
  .bible-word {
    transition: background-color 0.2s ease-out;
    transition-delay: 0s;
    border-radius: 4px;
    padding: 0 2px;
    cursor: pointer;
  }

  .bible-word.no-strongs {
    color: #779;
    cursor: default;
  }

  .bible-word.active-highlight {
    background-color: lightblue;
    transition: background-color 0.2s ease-in;
    transition-delay: 150ms; 
  }

   .bible-word.active-highlight-green {
    background-color: lightgreen;
    transition: background-color 0.2s ease-in;
    transition-delay: 150ms; 
  }
</style>
