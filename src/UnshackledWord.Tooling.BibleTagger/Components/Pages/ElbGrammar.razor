@page "/elb-grammar"
@using Microsoft.AspNetCore.Authorization
@using UnshackledWord.Domain.Extensions
@using UnshackledWord.Tooling.BibleTagger.Components.Common
@using UnshackledWord.Tooling.BibleTagger.Features.Elb1871SrTaggerRepository
@using UnshackledWord.Tooling.BibleTagger.Features.ElbGrammarRepository
@rendermode InteractiveServer
@inject IJSRuntime Js
@inject IElbGrammarRepository ElbRepo
@inject IMetaBibleRepository MetaRepo
@attribute [Authorize]

<PageTitle>Elberfelder Grammar</PageTitle>

<EditForm Model="@bibleReference" OnValidSubmit="HandleSubmitAsync">
  <DataAnnotationsValidator />
  <ValidationSummary />
  <div class="row reference-control">
    <div class="col-md-3">
      <label for="book">Book</label>
      <select id="book" class="form-control bibleReference-book" @bind="bibleReference.BookId">
        @foreach (var book in bibleBooks)
        {
          <option value="@book.Id">@book.Name</option>
        }
      </select>
    </div>

    <div class="col-md-3">
      <label for="chapter">Chapter</label>
      <input id="chapter" type="number" class="form-control bibleReference-chapter" @bind="bibleReference.Chapter" />
    </div>

    <div class="col-md-3">
      <label for="verse">Verse</label>
      <input id="verse" type="number" class="form-control bibleReference-verse" @bind="bibleReference.Verse" />
    </div>

    <div class="col-md-3">
      <button type="submit" class="btn btn-primary mt-3">Load Verse</button>
    </div>
  </div>

</EditForm>

<hr>

<div class="row">
  @* Elberfelder Words on the Left *@
  <div class="col-md-12">
    <h3>Elberfelder 1871: @bibleReference.ToString()</h3>
    <EditForm Model="@elberfelderWords" OnValidSubmit="SaveWordMappingAsync">
      <div class="word-form">

        <div class="word-row header">
          <div class="col select-col">Select</div>
          <div class="col word-col">Word</div>
          <div class="col lemma-col">Lemma</div>
          <div class="col forms-col">Other Forms</div>
          <div class="col pos-col">Part of Speech</div>
        </div>

        @foreach (var word in elberfelderWords)
        {
          <div class="word-row" @key="word.ElbWord.Id">
            <div class="col select-col" @onclick="() => ToggleSelection(word)">
              <InputCheckbox @bind-Value="word.Selected" />
            </div>
            <div class="col word-col" @onclick="() => ToggleSelection(word)">
              <input class="form-control-plaintext" value="@word.ElbWord.PlainWord" readonly />
            </div>
            <div class="col lemma-col">
              <InputText class="form-control" @bind-Value="word.ElbWord.Lemma" />
            </div>
            <div class="col forms-col">
              <InputText class="form-control" @bind-Value="word.ElbWord.OptionalForms" />
            </div>
            <div class="col pos-col">
              <InputSelect class="form-select" @bind-Value="word.ElbWord.PartOfSpeech">
                <option value=""> </option>
                @foreach (var (pos, text) in PartOfSpeechOptions)
                {
                  <option value="@pos">@text</option>
                }
              </InputSelect>
            </div>
          </div>
        }

        <div class="submit-container">
          <button type="submit" class="btn btn-primary">Submit Selected</button>
        </div>

      </div>
    </EditForm>
  </div>
</div>

<div class="row">
  <Notification Show="ShowNotification" OnClose="@HideNotification">
    <strong class="text-success">Success!</strong>
    <p>Your request was successfully processed.</p>
    @if (MappingResult is not null)
    {
      @foreach (var r in MappingResult.ModifiedElbWordIds)
      {
        <div class="d-flex flex-column">
          <div class="d-flex">
            <div class="p-2"><strong>Updated Word:</strong> @r.UpdatedPlainWord</div>
            <div class="p-2"><strong>Lemma:</strong> @r.UpdatedLemma</div>
            <div class="p-2"><strong>Part of Speech:</strong> @r.UpdatedPartOfSpeech</div>
          </div>
          <div class="p-2"><strong>Ids:</strong> @r.UpdatedIds.Select(x => x).OrderBy(x => x).JoinStrings(",")</div>
        </div>
        <hr />
      }
    }
  </Notification>
</div>

