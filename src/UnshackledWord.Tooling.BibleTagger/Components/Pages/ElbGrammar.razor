@page "/elb-grammar"
@using Microsoft.AspNetCore.Authorization
@using UnshackledWord.Domain.Extensions
@using UnshackledWord.Tooling.BibleTagger.Components.Common
@using UnshackledWord.Tooling.BibleTagger.Features.Elb1871SrTaggerRepository
@using UnshackledWord.Tooling.BibleTagger.Features.ElbGrammarRepository
@rendermode InteractiveServer
@inject IJSRuntime Js
@inject IElbGrammarRepository ElbRepo
@inject IMetaBibleRepository MetaRepo
@attribute [Authorize]

<PageTitle>Elberfelder Grammar</PageTitle>

<BibleVerseSelector @bind-BibleReference="@bibleReference" OnSubmit="@HandleSubmitAsync" />

<hr>

<MudText Typo="Typo.h5" Class="mb-4">Elberfelder 1871: @bibleReference.ToString()</MudText>

<EditForm Model="@elberfelderWords" OnValidSubmit="SaveWordMappingAsync">
  <MudTable Items="@elberfelderWords" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Elevation="1">
    <HeaderContent>
      <MudTh Style="width: 50px;">Select</MudTh>
      <MudTh>Word</MudTh>
      <MudTh>Lemma</MudTh>
      <MudTh>Other Forms</MudTh>
      <MudTh>Part of Speech</MudTh>
    </HeaderContent>
    <RowTemplate Context="rowContext">
      <MudTd DataLabel="Select">
        <MudCheckBox @bind-Value="@rowContext.Selected" Color="Color.Primary" />
      </MudTd>
      <MudTd DataLabel="Word">
        <MudText>@rowContext.ElbWord.PlainWord</MudText>
      </MudTd>
      <MudTd DataLabel="Other Forms">
        <MudTextField @bind-Value="@rowContext.ElbWord.OptionalForms" Margin="Margin.Dense" Variant="Variant.Outlined" />
      </MudTd>
    </RowTemplate>
  </MudTable>

  <div class="d-flex justify-end mt-4">
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
      Submit Selected
    </MudButton>
  </div>
</EditForm>

<div class="row">
  <Notification Show="ShowNotification" OnClose="@HideNotification">
    <strong class="text-success">Success!</strong>
    <p>Your request was successfully processed.</p>
    @if (MappingResult is not null)
    {
      @foreach (var r in MappingResult.ModifiedElbWordIds)
      {
        <div class="d-flex flex-column">
          <div class="d-flex">
            <div class="p-2"><strong>Updated Word:</strong> @r.UpdatedPlainWord</div>
            <div class="p-2"><strong>Lemma:</strong> @r.UpdatedLemma</div>
            <div class="p-2"><strong>Part of Speech:</strong> @r.UpdatedPartOfSpeech</div>
          </div>
          <div class="p-2"><strong>Ids:</strong> @r.UpdatedIds.Select(x => x).OrderBy(x => x).JoinStrings(",")</div>
        </div>
        <hr />
      }
    }
  </Notification>
</div>

