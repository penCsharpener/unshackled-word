@page "/elb1871-sr-tagger"
@using Microsoft.AspNetCore.Authorization
@using UnshackledWord.Domain.Extensions
@using UnshackledWord.Tooling.BibleTagger.Components.Common
@using UnshackledWord.Tooling.BibleTagger.Features.Elb1871SrTaggerRepository
@rendermode InteractiveServer
@inject IElbSrTaggerRepository ElbRepo
@inject IMetaBibleRepository MetaRepo
@inject IJSRuntime Js
@attribute [Authorize]

@* Form to select book, chapter, and verse *@
<EditForm Model="@bibleReference" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row reference-control">
        <div class="col-md-3">
            <label for="book">Book</label>
            <select id="book" class="form-control bibleReference-book" @bind="bibleReference.BookId">
                @foreach (var book in bibleBooks)
                {
                    <option value="@book.Id">@book.Name</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label for="chapter">Chapter</label>
            <input id="chapter" type="number" class="form-control bibleReference-chapter" @bind="bibleReference.Chapter" />
        </div>

        <div class="col-md-3">
            <label for="verse">Verse</label>
            <input id="verse" type="number" class="form-control bibleReference-verse" @bind="bibleReference.Verse" />
        </div>

        <div class="col-md-3">
          <button type="submit" class="btn btn-primary mt-3">Load Verse</button>
        </div>
    </div>

</EditForm>

<hr>

@* Two columns to display the words *@
<div class="row">
    @* Elberfelder Words on the Left *@
    <div class="col-md-6">
        <h3>Elberfelder 1871</h3>
        <div id="elberfelderWords">
            @foreach (var word in elberfelderWords)
            {
                <div class="word-item" @key="word.ElbWord.Id" @onclick="() => ToggleSelection(word)">
                    <input type="checkbox" class="word-checkbox" @bind="@word.Selected" />
                    <span class="word-text">@word.ElbWord.PlainWord</span>
                    <span class="word-lemma">@word.ElbWord.Lemma</span>
                    <span class="word-strongs">@word.ElbWord.Strongs</span>
                    <span class="part-of-speech">@word.ElbWord.PartOfSpeech</span>
                    <span class="word-id" style="display:none;">@word.ElbWord.Id</span>
                </div>
            }
        </div>
    </div>

    @* Greek Words on the Right *@
    <div class="col-md-6">
      <h3>Greek</h3>
      <div id="greekWords">
        @foreach (var word in greekWords)
        {
          <div class="word-item" @key="word.SrWord.Id" @onclick="() => ToggleSelection(word)">
            <input type="checkbox" class="word-checkbox" @bind="@word.Selected" />
            <span class="word-text">@word.SrWord.WordInContext</span>
            <span class="word-lemma">@word.SrWord.Lemma</span>
            <span class="word-strongs">@word.SrWord.Strongs</span>
            <span class="part-of-speech">@word.SrWord.PartOfSpeech</span>
            <span class="word-id" style="display:none;">@word.SrWord.Id</span>
          </div>
        }
      </div>
    </div>
</div>

@if (!invalidSelection)
{
  <div class="row">
    <Notification Show="ShowNotification" OnClose="@HideNotification">
      <strong class="text-success">Success!</strong>
      @if (MappingResult is not null)
      {
        <p>Inserted Tags: @MappingResult.InsertedTags</p>
        <p>Updated Ids: @MappingResult.UpdatedElbWordIds.JoinStrings(",")</p>
      }
    </Notification>
  </div>
}


@* Floating Button to Save Word Connections *@
<div class="fixed-bottom d-flex justify-content-center p-3">
    <button class="btn btn-success" @onclick="SaveWordMappingAsync" id="saveButton">
        Save Selected Words
    </button>
</div>
