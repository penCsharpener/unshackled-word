@implements IDisposable
@inject IJSRuntime Js

<MudOverlay @bind-Visible="_isOpen"
            AutoClose="true"
            ZIndex="1200"
            LockScroll="false"
            Opacity="0" />

<MudPopover Open="_isOpen"
            Fixed="false"
            Style="@_style"
            ZIndex="1300">
  <div class="container pa-4" style="display: flex; flex-direction: column; width: 500px; background: white; border: 1px solid #ddd;" id="word-detail-popup-container">
    <div class="section">
      <div class="strong-title">Strongs: @_strongs</div>
      <div class="count">97x in 65 Versen</div>
      <div class="details">@_lemma – @_lemmaTransliteration - @_glosses [+5]</div>
    </div>

    <!-- Section 2 -->
    <div class="section">
      <div class="lemma-title">Lemma:
        <span class="tag at">AT</span>
        <span class="tag nt">NT</span>
        zeugen
        </div>
      <div class="count">290x in 204 Versen</div>
      <div class="details">H3205 (198x); G1080 (47x); G3140 (19x); H5749:1 (11x); [+15x]</div>
    </div>

    <!-- Section 3 -->
    <div class="section">
      <div class="strong-title">Grammar: </div>
      @* <div class="count">47 Mal</div> *@
    </div>

    <!-- Section 4 -->
    <div class="section lock-emphasis">
      @* <div class="icon">⚲</div> *@
      @* <div class="text">Lock emphasis</div> *@
    </div>

    <!-- Section 5 (Footer/Legend) -->
    <div class="legend">
      <div class="legend-item">
        @* <span class="color-box purple"></span> *@
        @* Strong u. Lemma gleich *@
      </div>
      <div class="legend-item">
        <span class="color-box yellow"></span>
        Strong gleich
      </div>
      <div class="legend-item">
        @* <span class="color-box blue"></span> *@
        @* Lemma gleich *@
      </div>
    </div>
  </div>
</MudPopover>

@code {

  [CascadingParameter]
  public WordPopupService? PopupService { get; set; }

  private bool _isOpen;
  private string _style = "";
  private string _strongs = "strongs";
  private string _lemma = "γεννάω";
  private string _lemmaTransliteration = "gennao";
  private string _glosses = "zeugen; geboren sein; geboren werden;";
  private DotNetObjectReference<WordDetailPopOver>? _objRef;

  protected override void OnInitialized()
  {
    // Subscribe to the global word-click event
    if (PopupService is not null)
    {
      PopupService.OnWordSelected -= Show;
      PopupService.OnWordSelected += Show;
    }

    _objRef = DotNetObjectReference.Create(this);
  }

  private async Task Show(ElementReference element, string strongs)
  {
    _strongs = strongs;

    // Use the same JS interop logic to position the popup
    var bounds = await Js.InvokeAsync<BoundingRect>("getBoundingClientRect", element);
    double leftPos = bounds.Left + (bounds.Bottom / 2) - 140;
    _style = $"position: fixed; left: {bounds.Left}px; top: {leftPos + 5}px;";

    _isOpen = true;
    StateHasChanged();

    await Js.InvokeVoidAsync("listenForOutsideClick", _objRef, "word-detail-popup-container");
  }

  [JSInvokable]
  public void InvokeClose() {
    _isOpen = false;
    StateHasChanged();
  }

  public void Dispose()
  {
    if (PopupService is not null)
    {
      PopupService.OnWordSelected -= Show;
    }

    _objRef?.Dispose();
  }

  public record BoundingRect
  {
    public double Left { get; set; }
    public double Bottom { get; set; }
  }

}
