@using UnshackledWord.Domain.Extensions
@inject IJSRuntime Js

@if (Strongs.IsNullOrWhiteSpace())
{
  <span class="bible-word">@WordInContext @(" ")</span>
}
else
{
  <a class="bible-word" @ref="_ref" @onclick="OnClickHandler" data-strongs="@($"G{Strongs.PadLeft(4, '0')}")">@WordInContext</a>@(" ")
}

@* href="/readelberfelder/wordstudy/{@Strongs}"  *@

@code {
  [Parameter]
  public string? Strongs { get; set; }

  [Parameter, EditorRequired]
  public required string WordInContext { get; set; }

  [Parameter, EditorRequired]
  public required string Id { get; set; }

  [CascadingParameter]
  public WordPopupService? PopupService { get; set; }

  private ElementReference _ref;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      // Initialize the event delegation on the parent container
      await Js.InvokeVoidAsync("bibleInterop.initHighlighting", "chapter-container");
    }
  }

  private async Task OnClickHandler()
  {
    if (PopupService is not null && Strongs is not null)
    {
      await PopupService.ShowPopup(_ref, Strongs);
    }
  }
}
