@code {
  [Parameter] public bool Show { get; set; }
  [Parameter] public EventCallback OnClose { get; set; }
  [Parameter] public RenderFragment? ChildContent { get; set; }
  private string? _fadeClass = null;
  private string notificationId = Guid.NewGuid().ToString(); // Unique ID for each notification
  private DotNetObjectReference<Notification>? dotNetObject;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      dotNetObject = DotNetObjectReference.Create(this);
      _fadeClass = "fade-in";
      await JSRuntime.InvokeVoidAsync("startNotificationTimer", dotNetObject, 3000);
    }
  }

  protected override void OnParametersSet()
  {
    if (Show)
    {
      _fadeClass = "fade-in";
      // Start the auto close timer
    }
    else
    {
      _fadeClass = "fade-out";
    }
  }

  private async Task CloseNotification()
  {
    _fadeClass = "fade-out";
    // Wait for the fade-out effect to complete before raising the Close event
    await Task.Delay(500); // Match the duration of the fade-out transition
    await OnClose.InvokeAsync();
    Show = false;
    StateHasChanged();
  }

  [JSInvokable("CloseFromJs")]
  public async Task CloseFromJs()
  {
    await CloseNotification();
  }

  async ValueTask IAsyncDisposable.DisposeAsync()
  {
    dotNetObject?.Dispose();
  }
}

@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@if (Show)
{
  <div id="@notificationId" class="container my-3">
    <div class="toast show w-100" style="max-width: 100%; display: @(Show ? "block" : "none");"
         role="alert" aria-live="assertive" aria-atomic="true">
      <div class="toast-header">
        <strong class="me-auto">Notification</strong>
        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseNotification">
        </button>
      </div>
      <div class="toast-body">
        @ChildContent
      </div>
    </div>
  </div>
}
