{
  "AppSettings": {
    "BackupLocationPath": "../assets/Elb1871Mappings/",
    "DatabaseSeeding": {
      "SolutionAssetsPath": "../../assets",
      "SolutionTempPath": "../../temp",
      "Elberfelder1871TextFile": "elberfelder1871-theword-export.txt"
    }
  },
  "AgentMapping": {
    "Profiles": {
      "ollama": {
        "Kind": "ollama",
        "BaseUrl": "https://ollama.com",
        "Model": "gemma4:31b",
        "SchemaMode": "schema",
        "MaxParallel": 1,
        "MaxOutputTokens": 8192,
        "MaxTokensPerRun": 400000,
        "MaxVersesPerPackage": 12,
        "Models": {
          "gemma4_31b": { "Tag": "gemma4:31b", "InputPricePerMillion": 0, "CachedInputPricePerMillion": 0, "OutputPricePerMillion": 0 }
        }
      }
    }
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=test;"
  },
  "MappingEditing": {
    "Enabled": false
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173",
    "RequireSecureCookies": true
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "FromAddress": "noreply@unshackled-word.local",
    "FromName": "Unshackled Word",
    "Security": "None",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30
  },
  "Registration": {
    "Mode": "Open",
    "AllowedEmailDomains": [],
    "AllowedEmails": []
  },
  "Vocab": {
    "MeaningMinShare": 5,
    "MeaningMinCount": 2,
    "MeaningMax": 6
  },
  "VerseSimilarity": {
    "StopDfShare": 0.02,
    "TopK": 30,
    "MinScore": 0.1,
    "PhraseWeight": 0.5
  },
  "RateLimiting": {
    "Enabled": false,
    "General": { "PermitLimit": 300, "WindowSeconds": 60, "SegmentsPerWindow": 6 },
    "Strict": { "PermitLimit": 20, "WindowSeconds": 60, "SegmentsPerWindow": 6 }
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "./bin/unshackled-word.tooling.web-api-.log",
                "rollingInterval": "Day",
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}",
                "shared": true
              }
            }
          ]
        }
      }
    ],
    "Properties": {
      "ApplicationName": "UnshackledWord.Tooling.WebApi"
    }
  }
}
