              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "./bin/unshackled-word.tooling.web-api-.log",
                "rollingInterval": "Day",
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}",
                "shared": true
              }
            }
          ]
        }
      }
    ],
    "Properties": {
      "ApplicationName": "UnshackledWord.Tooling.WebApi"
    }
