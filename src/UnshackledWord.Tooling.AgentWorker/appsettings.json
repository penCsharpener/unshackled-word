{
  "AppSettings": {
    "DatabaseSeeding": {
      "SolutionAssetsPath": "../../assets"
    }
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=test;"
  },
  "AgentMapping": {
    "Profiles": {
      "ollama": {
        "Kind": "ollama",
        "BaseUrl": "https://ollama.com",
        "Model": "gemma4:31b",
        "SchemaMode": "schema",
        "MaxParallel": 1,
        "MaxOutputTokens": 8192,
        "MaxTokensPerRun": 400000,
        "MaxVersesPerPackage": 12,
        "Models": {
          "gemma4_31b": { "Tag": "gemma4:31b", "InputPricePerMillion": 0, "CachedInputPricePerMillion": 0, "OutputPricePerMillion": 0 }
        }
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": { "Default": "Warning", "Override": { "UnshackledWord": "Information" } },
    "WriteTo": [ { "Name": "Console" } ]
  }
}
