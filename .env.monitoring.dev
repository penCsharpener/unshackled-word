# Dev-only values for compose.monitoring.dev.yml. Not secret, never use in production.
# The dev API runs with host networking (compose.override.yml), so it reaches the collector on the published loopback port.
TELEMETRY_ENABLED=true
TELEMETRY_OTLP_ENDPOINT=http://localhost:4317
TELEMETRY_TRACE_SAMPLE_RATIO=1.0

GRAFANA_ADMIN_PASSWORD=dev-admin
GRAFANA_ROOT_URL=http://localhost:3000
MONITORING_ALERT_EMAIL=alerts@unshackled-word.local
MONITORING_GRAFANA_DB_PASSWORD=dev-grafana
MONITORING_EXPORTER_DB_PASSWORD=dev-exporter

UMAMI_DB_PASSWORD=dev-umami
UMAMI_APP_SECRET=dev-only-not-a-secret-0123456789abcdef
UMAMI_PROXY_TARGET=http://host.docker.internal:3002

VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
VITE_OPERATOR_NAME=Dev
VITE_OPERATOR_CONTACT=dev@example.org
