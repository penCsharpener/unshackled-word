# Production .env template. Copy to .env next to compose.yml, fill in every <...>, then `chmod 600 .env`.
# Never commit .env. Details: docs/deployment.md (section 4.2).
# Start with: docker compose --env-file .env -f compose.yml -f deployment/compose.prod.yml up -d --build

# --- Database (required) ----------------------------------------------------
POSTGRES_DB=unshackledword
POSTGRES_USER=unshackledword
POSTGRES_PASSWORD=<long random password>
# Must match the three values above; host is the compose service name.
POSTGRES_CONNECTIONSTRING="Host=unshackledword.tooling.database;Port=5432;Database=unshackledword;Username=unshackledword;Password=<same password>;"

# --- App (required) ---------------------------------------------------------
ENVIRONMENT=Production
# Public origin, no trailing path. Drives email links, CORS and the passkey origin.
FRONTEND_BASE_URL=https://word.example.org
REQUIRE_SECURE_COOKIES=true
# Open | Restricted
REGISTRATION_MODE=Restricted
# Keep false unless this instance is the one that edits mappings.
MAPPING_EDITING_ENABLED=false
MCP_LOG_LEVEL=Information
# Address the web container binds to; the reverse proxy forwards here. Not for the public internet.
WEB_BIND=127.0.0.1:8081

# --- Email (required: real SMTP provider, dedicated sending account) --------
EMAIL_SMTP_HOST=smtp.example.org
EMAIL_SMTP_PORT=587
# None | StartTls | SslOnConnect | Auto
EMAIL_SECURITY=StartTls
EMAIL_USERNAME=<smtp user>
EMAIL_PASSWORD=<smtp password>
EMAIL_FROM_ADDRESS=noreply@example.org

# --- Rate limiting of anonymous callers (optional) --------------------------
RATE_LIMITING_ENABLED=true
# Docker network of the reverse proxy, e.g. 172.18.0.0/16 (needed so client IPs are read correctly)
REVERSE_PROXY_NETWORK=<proxy network CIDR>

# --- Object storage / vocab audio (optional, Garage) ------------------------
# Generate each yourself before the first Garage start (placeholders and all zeros are rejected):
#   openssl rand -hex 32   # GARAGE_RPC_SECRET, exactly 64 hex chars
#   openssl rand -hex 24   # GARAGE_ADMIN_TOKEN
GARAGE_RPC_SECRET=<64 hex chars>
GARAGE_ADMIN_TOKEN=<long random token>
# Values from `garage key info --show-secret` (docs/deployment.md, Object storage)
OBJECT_STORAGE_SERVICE_URL=http://unshackledword.garage:3900
# Your public origin plus /media
OBJECT_STORAGE_PUBLIC_URL=https://word.example.org/media
UNSHACKLEDWORD_OBJECT_STORAGE_ACCESS_KEY=<Key ID from garage key info>
UNSHACKLEDWORD_OBJECT_STORAGE_SECRET_KEY=<Secret key from garage key info>

# --- Monitoring and analytics (optional, only with compose.monitoring.yml) --
# See .env.monitoring.example for dev defaults and docs/deployment.md section 9.
TELEMETRY_ENABLED=true
TELEMETRY_OTLP_ENDPOINT=http://unshackledword.monitoring:4317
# Share of traces kept
TELEMETRY_TRACE_SAMPLE_RATIO=0.1
GRAFANA_ADMIN_PASSWORD=<long random password>
GRAFANA_ROOT_URL=https://monitor.example.org
GRAFANA_SMTP_STARTTLS_POLICY=OpportunisticStartTLS
MONITORING_ALERT_EMAIL=ops@example.org
# Login passwords of the Postgres roles uw_grafana / uw_monitor
MONITORING_GRAFANA_DB_PASSWORD=<random>
MONITORING_EXPORTER_DB_PASSWORD=<random>
UMAMI_DB_PASSWORD=<random>
UMAMI_APP_SECRET=<long random string>
UMAMI_PROXY_TARGET=http://host.docker.internal:3002

# --- Frontend build time (set before `bun run build`) -----------------------
VITE_UMAMI_WEBSITE_ID=<id from Umami>
VITE_OPERATOR_NAME=<name for the privacy page>
VITE_OPERATOR_CONTACT=<contact for the privacy page>
